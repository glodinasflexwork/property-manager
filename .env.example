# Property Manager Pro - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application identifier (used in JWT tokens and branding)
VITE_APP_ID=property-manager-pro

# Application display name
VITE_APP_TITLE=Property Manager Pro

# Application URL (used for magic link redirects and OAuth callbacks)
# Development: http://localhost:3000
# Production: https://yourdomain.com
APP_URL=http://localhost:3000

# =============================================================================
# AUTHENTICATION SYSTEM
# =============================================================================
# Choose which authentication system to use
# Options: 'oauth' (Manus OAuth) or 'magic-link' (Passwordless Email)
# Default: magic-link
AUTH_TYPE=magic-link

# =============================================================================
# JWT / SESSION CONFIGURATION
# =============================================================================

# Secret key for signing JWT tokens and session cookies
# IMPORTANT: Use a strong random string in production
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secure-random-secret-change-this-in-production

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database connection URL
# 
# For OAuth (Developer 1) - MySQL/TiDB:
# DATABASE_URL=mysql://username:password@host:port/database_name
#
# For Magic Link (Developer 2) - PostgreSQL/Neon:
# DATABASE_URL=postgresql://username:password@host:port/database_name
#
# Example (Neon):
# DATABASE_URL=postgresql://user:pass@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/database

# =============================================================================
# OAUTH CONFIGURATION (for AUTH_TYPE=oauth)
# =============================================================================
# Required only if using Manus OAuth authentication

# Manus OAuth server URL
# Production: https://oauth.manus.im
# Development: https://oauth-dev.manus.im (if available)
OAUTH_SERVER_URL=https://oauth.manus.im

# Manus OAuth portal URL (for frontend redirects)
# Should match OAUTH_SERVER_URL
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im

# =============================================================================
# MAGIC LINK CONFIGURATION (for AUTH_TYPE=magic-link)
# =============================================================================
# Required only if using Magic Link authentication

# Resend API Key
# Get your API key from: https://resend.com/api-keys
# Test mode: Can only send to verified email addresses
# Production: Requires domain verification
RESEND_API_KEY=re_your_api_key_here

# Email sender address
# Test mode: Use onboarding@resend.dev
# Production: Use your verified domain (e.g., noreply@yourdomain.com)
# Must verify domain in Resend dashboard first
EMAIL_FROM=onboarding@resend.dev

# =============================================================================
# OPTIONAL: ANALYTICS
# =============================================================================

# Umami analytics endpoint (optional)
# Leave empty to disable analytics
VITE_ANALYTICS_ENDPOINT=

# =============================================================================
# OPTIONAL: FORGE API (for external integrations)
# =============================================================================

# Built-in Forge API URL (optional)
BUILT_IN_FORGE_API_URL=

# Built-in Forge API Key (optional)
BUILT_IN_FORGE_API_KEY=

# =============================================================================
# DEVELOPER NOTES
# =============================================================================

# Developer 1 (OAuth + MySQL) Example:
# -----------------------------------
# AUTH_TYPE=oauth
# DATABASE_URL=mysql://root:password@localhost:3306/property_manager
# OAUTH_SERVER_URL=https://oauth.manus.im
# VITE_OAUTH_PORTAL_URL=https://oauth.manus.im
# JWT_SECRET=your-secret-here
# VITE_APP_ID=property-manager-pro
# APP_URL=http://localhost:3000

# Developer 2 (Magic Link + PostgreSQL) Example:
# ----------------------------------------------
# AUTH_TYPE=magic-link
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=onboarding@resend.dev
# JWT_SECRET=your-secret-here
# VITE_APP_ID=property-manager-pro
# APP_URL=http://localhost:3002

# Production (Magic Link + PostgreSQL) Example:
# ---------------------------------------------
# AUTH_TYPE=magic-link
# DATABASE_URL=postgresql://user:pass@production-host/property_manager
# RESEND_API_KEY=re_production_api_key
# EMAIL_FROM=noreply@yourdomain.com
# JWT_SECRET=super-secure-random-string-generated-with-openssl
# VITE_APP_ID=property-manager-pro
# APP_URL=https://app.yourdomain.com

# =============================================================================
# SECURITY BEST PRACTICES
# =============================================================================

# 1. Never commit .env file to version control
# 2. Use different secrets for development and production
# 3. Rotate JWT_SECRET periodically in production
# 4. Use environment-specific API keys (test vs production)
# 5. Enable SSL/TLS in production (https://)
# 6. Verify your domain in Resend before production deployment
# 7. Use strong database passwords
# 8. Restrict database access by IP address
# 9. Enable database SSL connections in production
# 10. Keep this .env.example file updated when adding new variables

# =============================================================================
# TROUBLESHOOTING
# =============================================================================

# Issue: "OAUTH_SERVER_URL is not configured"
# Solution: Set OAUTH_SERVER_URL if using AUTH_TYPE=oauth
#           Or set AUTH_TYPE=magic-link and configure Resend

# Issue: "Resend API key is invalid"
# Solution: Check your API key at https://resend.com/api-keys
#           Ensure no extra spaces or quotes

# Issue: "Can't send email to this address"
# Solution: In test mode, you can only send to verified emails
#           Verify your domain in Resend for production use

# Issue: "Database connection failed"
# Solution: Check DATABASE_URL format and credentials
#           Ensure database server is running and accessible
#           Check SSL mode for PostgreSQL connections

# Issue: "Cookie not set / Session not persisting"
# Solution: Check APP_URL matches your actual URL
#           Ensure JWT_SECRET is set
#           Check browser cookie settings (allow cookies)
