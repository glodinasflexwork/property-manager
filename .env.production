# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES FOR VERCEL
# =============================================================================
# Copy these values to Vercel Dashboard → Project Settings → Environment Variables
# After deployment, update APP_URL with your actual Vercel URL
# =============================================================================

# Database Configuration
DATABASE_URL=postgresql://neondb_owner:npg_Q35JojzwHWvb@ep-nameless-unit-aeurlrjw-pooler.c-2.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Application Configuration
VITE_APP_ID=property-manager-app
VITE_APP_TITLE=Property Manager Pro

# JWT/Cookie Secret
# IMPORTANT: Generate a new secure secret for production!
# Use: openssl rand -base64 32
JWT_SECRET=dev-secret-change-in-production-12345

# Magic Link Authentication
RESEND_API_KEY=re_PPZUzVTe_HCUKybDrYyb6wLy1gYL7shiM
EMAIL_FROM=onboarding@resend.dev

# Application URL
# IMPORTANT: Update this after first deployment with your actual Vercel URL
# Example: https://property-manager-abc123.vercel.app
APP_URL=https://your-app-name.vercel.app

# OAuth Configuration (placeholders - not used but required by code)
OAUTH_SERVER_URL=https://placeholder.com
VITE_OAUTH_PORTAL_URL=https://placeholder.com

# Optional: Owner Configuration
OWNER_OPEN_ID=

# Optional: Forge API Configuration
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Node Environment (Vercel sets this automatically)
NODE_ENV=production

# =============================================================================
# INSTRUCTIONS FOR VERCEL DEPLOYMENT
# =============================================================================
#
# 1. Go to Vercel Dashboard: https://vercel.com/dashboard
# 2. Select your project (or import from GitHub)
# 3. Go to: Settings → Environment Variables
# 4. Add each variable above (one by one):
#    - Variable Name: DATABASE_URL
#    - Value: postgresql://neondb_owner:npg_Q35JojzwHWvb@...
#    - Environment: Production, Preview, Development (check all)
#    - Click "Save"
# 5. Repeat for all variables
# 6. After first deployment, get your Vercel URL
# 7. Update APP_URL with the actual URL
# 8. Redeploy to apply the updated APP_URL
#
# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# ⚠️  BEFORE PRODUCTION DEPLOYMENT:
# 1. Generate a new JWT_SECRET:
#    openssl rand -base64 32
# 2. Verify your domain in Resend and update EMAIL_FROM
# 3. Never commit this file to Git (it's in .gitignore)
# 4. Rotate secrets periodically
# 5. Use different secrets for staging and production
#
# =============================================================================
